{
  "name": "spirometry-checker",
  "productName": "SEMed Tools",
  "version": "1.0.3",
  "description": "SEMed Tools — รวมเครื่องมือของ SEMed (ตรวจไฟล์ผลตรวจปอด และอื่นๆ)",
  "main": "src/main/main.js",
  "author": "SEMed",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win",
    "release": "node --env-file-if-exists=.env node_modules/electron-builder/cli.js --win --publish always",
    "ship": "npm test && npm version patch && git push --follow-tags && npm run release",
    "ship:minor": "npm test && npm version minor && git push --follow-tags && npm run release",
    "ship:major": "npm test && npm version major && git push --follow-tags && npm run release"
  },
  "build": {
    "appId": "th.co.semed.spirometry-checker",
    "productName": "SEMed Tools",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SEMed Tools",
      "artifactName": "semed-tools-setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mamypopo",
        "repo": "semed-exe",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mamypopo/semed-exe.git"
  }
}
