{
  "name": "spirometry-checker",
  "productName": "ตรวจสอบไฟล์ผลตรวจปอด",
  "version": "1.0.0",
  "description": "ตรวจสอบความสมบูรณ์ของไฟล์ผลตรวจปอด (Spirometry)",
  "main": "src/main/main.js",
  "author": "SEMed",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "th.co.semed.spirometry-checker",
    "productName": "ตรวจสอบไฟล์ผลตรวจปอด",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ตรวจสอบไฟล์ผลตรวจปอด",
      "artifactName": "spirometry-checker-setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "REPLACE_GITHUB_OWNER",
        "repo": "REPLACE_GITHUB_REPO"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
